---
import { profile } from '../data';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found, {profile.name}</title>
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
    <style>
      :root { --bg: #fbfaf8; --fg: #1a1a1a; --fg-2: #5b5b5b; --line: #e2ded6; }
      @media (prefers-color-scheme: dark) { :root { --bg: #111111; --fg: #ededed; --fg-2: #a6a6a6; --line: #333333; } }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg); font-family: Georgia, 'Times New Roman', serif; padding: 24px; }
      main { max-width: 420px; text-align: center; display: grid; gap: 14px; }
      h1 { font-weight: 500; font-size: 28px; margin: 0; }
      p { margin: 0; color: var(--fg-2); line-height: 1.6; }
      a { justify-self: center; margin-top: 8px; padding: 10px 20px; border: 1px solid var(--line); border-radius: 999px; color: var(--fg); text-decoration: none; font: 500 14px system-ui, sans-serif; }
    </style>
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>There's only one page here.</p>
      <a href={`${b}/`}>Go to iandre.com</a>
    </main>
  </body>
</html>
